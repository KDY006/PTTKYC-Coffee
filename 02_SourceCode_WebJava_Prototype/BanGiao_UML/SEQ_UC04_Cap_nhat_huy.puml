@startuml
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam BackgroundColor white
skinparam ArrowColor #405447
skinparam activityBackgroundColor #F3F6F3
skinparam activityBorderColor #47634F
skinparam sequenceParticipantBackgroundColor #F1F5F1
skinparam sequenceLifeLineBorderColor #829388
skinparam sequenceActivationBackgroundColor #DAE6DD
skinparam sequenceActivationBorderColor #52705B
skinparam noteBackgroundColor #FFFBEF
skinparam noteBorderColor #A4986E
skinparam dpi 170
skinparam wrapWidth 190
skinparam maxMessageSize 360
skinparam noteTextAlignment left
hide footbox
autonumber
actor "Thu ngân" as A
boundary "banhang.html\nbanhang.js" as UI
control "OrderController" as C
control "OrderService" as S
entity "Repository JPA" as R
database "MySQL/MariaDB" as DB
A -> UI : Sửa/hủy dòng; Lưu đơn
activate UI
UI -> C : PUT /api/order/{id}/mon\nOrderDTO + phienBan
activate C
C -> C : Kiểm tra session
C -> S : capNhatDon(id,dto)
activate S
note over S,DB : Transaction cập nhật đơn
S -> R : khoaHoaDon(id)
activate R
R -> DB : SELECT hóa đơn FOR UPDATE
activate DB
DB --> R : Hóa đơn và version hiện tại
 deactivate DB
R --> S : Hóa đơn
 deactivate R
alt Đơn đã kết thúc hoặc version cũ
 S --> C : Lỗi xung đột 409
else Đơn mở và version đúng
 S -> R : Đọc món; saveAndFlush(hoaDon)
 activate R
 R -> DB : SELECT món; DELETE/INSERT chi tiết;\nUPDATE tổng và version
 activate DB
 DB --> R : Kết quả
 deactivate DB
 R --> S : Hóa đơn cập nhật
 deactivate R
 note over S,DB : Commit; lỗi lưu thì rollback
 S --> C : Hóa đơn mới
end
 deactivate S
C --> UI : JSON hoặc lỗi
 deactivate C
UI --> A : Tổng mới hoặc yêu cầu tải lại
 deactivate UI
== Nhánh hủy toàn bộ đơn ==
A -> UI : Xác nhận hủy đơn
activate UI
UI -> C : POST /api/order/{id}/huy\n{phienBan}
activate C
C -> S : huyDonHang(id,version)
activate S
S -> R : Khóa và kiểm tra; ghi DA_HUY; trả bàn
activate R
R -> DB : UPDATE hóa đơn và bàn trong transaction
activate DB
DB --> R : Kết quả
 deactivate DB
R --> S : Hóa đơn đã hủy
 deactivate R
S --> C : Kết quả sau commit
 deactivate S
C --> UI : JSON hoặc lỗi; PAID bị từ chối
 deactivate C
UI --> A : Đơn đã hủy; không trừ kho
 deactivate UI

@enduml
